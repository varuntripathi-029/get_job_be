# Copy to .env and fill in. .env is gitignored — never commit real values.

# Database
DATABASE_URL=postgresql+asyncpg://hiresignal:hiresignal@localhost:5432/hiresignal

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — Google OAuth 2.0 (console.cloud.google.com → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — provider is set per role: gemini | openai | anthropic | xai
# Only the providers you actually reference below need a key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# The classifier runs on EVERY page that clears the pre-filter, so it dominates
# LLM cost. gemini-2.5-flash-lite is $0.10/1M in (with a free tier) against
# ~$1.25/1M for the cheapest Grok — switch to xai here only if you'd rather
# run on a single key and accept the bill.
CLASSIFIER_PROVIDER=xai
CLASSIFIER_MODEL=grok-4.20-0309-non-reasoning

# The extractor only sees content that survived the classifier, so volume is
# low and quality matters more than price.
EXTRACTOR_PROVIDER=xai
EXTRACTOR_MODEL=grok-4.3

# News APIs (all optional — the fetcher skips any provider with no key)
NEWSAPI_KEY=
GNEWS_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# App
APP_NAME=HireSignal
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Crawler
CRAWLER_USER_AGENT=HireSignal/1.0 (+https://yourdomain.com/bot)
PLAYWRIGHT_MAX_CONCURRENT=2
RATE_LIMIT_SECONDS_PER_DOMAIN=5.0
CRAWL_LOG_RETENTION_DAYS=10
SCHEDULER_BATCH_SIZE=10
