# Copy to .env and fill in. .env is gitignored — never commit real values.

# Database
DATABASE_URL=postgresql+asyncpg://hiresignal:hiresignal@localhost:5432/hiresignal

# Redis — Upstash (serverless) in production; TLS is mandatory.
# The REST token from the Upstash console doubles as the Redis password.
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379
# Local Docker alternative:
REDIS_URL=redis://localhost:6379/0

# Auth — Google OAuth 2.0 (console.cloud.google.com → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — provider is set per role: gemini | openai | anthropic | groq | xai
# Only the providers you actually reference below need a key.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional alternatives.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# The classifier runs on EVERY page that clears the pre-filter, so it dominates
# LLM cost. llama-3.1-8b-instant is $0.05/$0.08 per 1M and ~840 tok/s, which is
# the cheapest credible option for a binary relevance gate.
CLASSIFIER_PROVIDER=groq
CLASSIFIER_MODEL=llama-3.1-8b-instant

# The extractor only sees content that survived the classifier, so volume is
# low and structured-output quality matters more than price.
# gpt-oss-120b is $0.15/$0.60 per 1M; llama-3.3-70b-versatile is the
# alternative at $0.59/$0.79.
EXTRACTOR_PROVIDER=groq
EXTRACTOR_MODEL=openai/gpt-oss-120b

# News APIs (all optional — the fetcher skips any provider with no key)
NEWSAPI_KEY=
GNEWS_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# Embeddings — Groq serves no embedding model, so this is always a separate
# provider from the chat roles above. Gemini's free tier covers this project;
# get a key at aistudio.google.com/apikey (no card required).
# gemini-embedding-001 is the only embedding model Google still serves
# (text-embedding-004 was retired). It is natively 3072-dim; the client requests
# 768 to match the Vector(768) columns and re-normalises the result.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Resumes (PII — rows expire and are deleted by the cleanup worker)
MAX_RESUME_SIZE_MB=5
RESUME_EXPIRY_DAYS=90

# Newsletter — Resend free tier is 100 emails/day at 2 req/s.
NEWSLETTER_DAILY_SEND_LIMIT=100
NEWSLETTER_SEND_DELAY_SECONDS=1.0
NEWSLETTER_CONFIRM_TTL_HOURS=48

# App
APP_NAME=HireSignal
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173
# Base for links inside newsletter emails. No trailing slash.
FRONTEND_URL=http://localhost:5173

# Crawler
CRAWLER_USER_AGENT=HireSignal/1.0 (+https://yourdomain.com/bot)
PLAYWRIGHT_MAX_CONCURRENT=2
RATE_LIMIT_SECONDS_PER_DOMAIN=5.0
CRAWL_LOG_RETENTION_DAYS=10
SCHEDULER_BATCH_SIZE=10
