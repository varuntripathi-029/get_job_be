# Copy to .env and fill in. .env is gitignored — never commit real values.

# Database
DATABASE_URL=postgresql+asyncpg://hiresignal:hiresignal@localhost:5432/hiresignal

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — Google OAuth 2.0 (console.cloud.google.com → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — Gemini is the default; OpenAI/Anthropic are optional alternatives
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=gemini-2.0-flash
EXTRACTOR_MODEL=gemini-1.5-pro

# News APIs (all optional — the fetcher skips any provider with no key)
NEWSAPI_KEY=
GNEWS_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# App
APP_NAME=HireSignal
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Crawler
CRAWLER_USER_AGENT=HireSignal/1.0 (+https://yourdomain.com/bot)
PLAYWRIGHT_MAX_CONCURRENT=2
RATE_LIMIT_SECONDS_PER_DOMAIN=5.0
CRAWL_LOG_RETENTION_DAYS=10
SCHEDULER_BATCH_SIZE=10
