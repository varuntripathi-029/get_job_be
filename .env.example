# Copy to .env and fill in. .env is gitignored — never commit real values.

# Database
DATABASE_URL=postgresql+asyncpg://hiresignal:hiresignal@localhost:5432/hiresignal

# Redis (TLS required in production, e.g. Upstash)
REDIS_URL=redis://localhost:6379/0

# Google OAuth 2.0 — console.cloud.google.com → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET_KEY=change-me-to-a-random-string   # openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — provider per role: gemini | openai | anthropic | groq | xai
# Only the providers referenced below need a key.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional alternative chat providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Classifier: cheap relevance gate, runs on every crawled page
CLASSIFIER_PROVIDER=groq
CLASSIFIER_MODEL=openai/gpt-oss-20b

# Extractor: structured extraction, only on pages the classifier accepts
EXTRACTOR_PROVIDER=groq
EXTRACTOR_MODEL=openai/gpt-oss-120b

# Embeddings — Groq has no embedding model, so use a different provider
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# News / search APIs (all optional; a provider with no key is skipped)
NEWSAPI_KEY=
GNEWS_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# Resumes
MAX_RESUME_SIZE_MB=5
RESUME_EXPIRY_DAYS=90

# Newsletter
NEWSLETTER_DAILY_SEND_LIMIT=100
NEWSLETTER_SEND_DELAY_SECONDS=1.0
NEWSLETTER_CONFIRM_TTL_HOURS=48

# App
APP_NAME=HireSignal
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Crawler
CRAWLER_USER_AGENT=HireSignal/1.0 (+https://yourdomain.com/bot)
PLAYWRIGHT_MAX_CONCURRENT=2
RATE_LIMIT_SECONDS_PER_DOMAIN=5.0
CRAWL_LOG_RETENTION_DAYS=10

# HTTP scheduler — external cron drives crawls (see .github/workflows/scheduler.yml)
# Empty disables the endpoints (503). Generate: openssl rand -hex 32
SCHEDULER_TOKEN=
SCHEDULER_DEADLINE_SECONDS=50
SCHEDULER_BATCH_SIZE=3
